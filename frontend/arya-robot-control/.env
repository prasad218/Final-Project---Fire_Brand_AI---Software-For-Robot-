# Copy this file to .env (or .env.local) and adjust if your backend
# isn't on localhost:8000 — e.g. if the robot's PC has a different IP
# on your network and you're opening the frontend from a phone/tablet:
#
#   VITE_API_BASE_URL=http://192.168.1.42:8000
#
# VITE_WS_BASE_URL is optional — it's derived automatically from
# VITE_API_BASE_URL (http->ws, https->wss) if you don't set it.

VITE_API_BASE_URL=http://192.168.1.4:8000
# VITE_WS_BASE_URL=ws://localhost:8000
